#!/bin/bash
# Template do processo usado para migrar /home/admin/cppgi -> /opt/cppgi.
# Reutilize para outras pastas (ex: o venv em /home/admin/moduloPesquisaPRPI).
#
# Copie para uma cópia real (ex: migrar_para_opt.sh, já ignorado pelo .gitignore),
# ajuste as variáveis abaixo e revise a lista de "referências externas" antes de
# rodar em produção. Este script NÃO apaga a origem sozinho - isso é passo manual
# no final, depois de validar que tudo funciona no novo caminho (smoke test
# automático abaixo cobre a checagem básica, mas vale conferir logs também).
set -euo pipefail

# ---- Configuração (ajuste para cada migração) ----
SRC_DIR="/home/admin/moduloPesquisaPRPI"
DST_DIR="/opt/moduloPesquisaPRPI"
OWNER="admin"
GROUP="pesquisa"

# Serviços que precisam ficar parados durante o corte (cutover) porque
# referenciam SRC_DIR. Ordem importa: cppgi.service Requires=pesquisa.service
# (ver cppgi.service.sample), então para primeiro o dependente (cppgi) e só
# depois a dependência (pesquisa) - e sobe na ordem inversa. pesquisa.service
# é quem roda de fato a partir de moduloPesquisaPRPI; cppgi.service só usa o
# venv de lá (PATH=/ExecStart=) e exige que pesquisa.service esteja no ar.
# Deixe vazio se nada depender deste diretório em runtime.
SERVICES_TO_STOP=("cppgi.service" "pesquisa.service")

# Subpastas que devem ganhar escrita de grupo (g+w) depois do chmod base.
# moduloPesquisaPRPI/app é o próprio app do pesquisa.service rodando (não só
# o venv) - ele grava em app.log e nas pastas abaixo. Isso espelha o
# ReadWritePaths=/home/admin/moduloPesquisaPRPI/app do pesquisa.service, que
# já libera escrita nessa árvore inteira; sem isso o serviço roda como
# User=pesquisa, cai nas permissões de grupo (g=rX, só leitura) e falha ao
# tentar gravar upload/log/pdf depois do corte.
WRITABLE_SUBDIRS=("app")

# Arquivos de sistema que referenciam SRC_DIR e precisam apontar para DST_DIR
# antes de religar os serviços: as units systemd (WorkingDirectory=/ExecStart=
# ou, no caso do cppgi, PATH= do venv), o crontab (jobs que rodam scripts/
# comandos dentro do caminho antigo) e a config do CloudWatch agent (paths de
# log monitorados, ex: app.json). Ajuste para cada migração - nem toda pasta
# aparece em todos esses lugares.
REFERENCE_FILES=(
    "/etc/systemd/system/pesquisa.service"
    "/etc/systemd/system/cppgi.service"
    "/etc/crontab"
    "/opt/aws/amazon-cloudwatch-agent/bin/config.json"
)

# URLs para o smoke test pós-corte (uma requisição HTTP real por serviço,
# equivalente ao "curl" que seria feito manualmente).
SMOKE_TEST_URLS=(
    "https://aws.yokoapps.com.br/pesquisa"
    "https://aws.yokoapps.com.br/cppgi"
)

# Diretório raiz onde uma cópia de cada REFERENCE_FILES é guardada antes de
# editá-lo (backup para reversão manual, caso o smoke test falhe ou algo dê
# errado depois do corte). Cada execução cria uma subpasta com timestamp.
BACKUP_ROOT_DIR="/root/migracoes-backup"

# ---- Fase 1: cópia (pode rodar com o(s) serviço(s) ainda no ar) ----
echo "==> Copiando $SRC_DIR -> $DST_DIR via rsync..."
sudo mkdir -p "$(dirname "$DST_DIR")"
sudo rsync -a "$SRC_DIR"/ "$DST_DIR"/

echo "==> Verificando integridade da cópia (diff recursivo)..."
if ! diff -rq "$SRC_DIR" "$DST_DIR"; then
    echo "ERRO: origem e destino diferem. Corrija antes de continuar." >&2
    exit 1
fi
echo "Cópia validada - origem e destino idênticos."

# ---- Fase 2: dono/permissões no destino ----
echo "==> Ajustando dono/grupo e permissões em $DST_DIR..."
sudo chown -R "$OWNER:$GROUP" "$DST_DIR"
sudo chmod -R u=rwX,g=rX,o= "$DST_DIR"
for dir in "${WRITABLE_SUBDIRS[@]:-}"; do
    [ -n "$dir" ] && sudo chmod -R g+w "$DST_DIR/$dir"
done

if [ -d "$DST_DIR/.git" ]; then
    echo "==> Registrando $DST_DIR como safe.directory do git..."
    sudo git config --system --add safe.directory "$DST_DIR"
fi

# ---- Fase 3: corte (cutover) - aqui sim precisa parar quem depende do caminho antigo ----
if [ "${#SERVICES_TO_STOP[@]}" -gt 0 ]; then
    echo "==> Parando serviços dependentes: ${SERVICES_TO_STOP[*]}"
    for svc in "${SERVICES_TO_STOP[@]}"; do
        sudo systemctl stop "$svc"
    done
fi

# ---- Fase 4: atualizar referências e religar os serviços ----
BACKUP_DIR="$BACKUP_ROOT_DIR/$(date +%Y%m%d-%H%M%S)-$(basename "$SRC_DIR")"
echo "==> Fazendo backup dos arquivos de referência em $BACKUP_DIR..."
sudo mkdir -p "$BACKUP_DIR"

echo "==> Atualizando referências de $SRC_DIR para $DST_DIR..."
for f in "${REFERENCE_FILES[@]}"; do
    if [ -f "$f" ]; then
        sudo cp -a --parents "$f" "$BACKUP_DIR"
        sudo sed -i "s#$SRC_DIR#$DST_DIR#g" "$f"
        echo "    - $f atualizado (backup em $BACKUP_DIR$f)"
    else
        echo "    - AVISO: $f não encontrado, pulando" >&2
    fi
done

echo "==> Recarregando systemd (daemon-reload)..."
sudo systemctl daemon-reload

echo "==> Reaplicando config do CloudWatch agent..."
sudo /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
    -a fetch-config -m ec2 -s \
    -c file:/opt/aws/amazon-cloudwatch-agent/bin/config.json

if [ "${#SERVICES_TO_STOP[@]}" -gt 0 ]; then
    echo "==> Subindo serviços na ordem inversa da parada..."
    for (( idx=${#SERVICES_TO_STOP[@]}-1 ; idx>=0 ; idx-- )); do
        svc="${SERVICES_TO_STOP[$idx]}"
        echo "    - iniciando $svc"
        sudo systemctl start "$svc"
    done
fi

# ---- Fase 5: smoke test (requisição HTTP real por serviço) ----
echo "==> Smoke test em $DST_DIR..."
SMOKE_TEST_FAILED=0
for url in "${SMOKE_TEST_URLS[@]:-}"; do
    [ -z "$url" ] && continue
    echo -n "    - $url: "
    codigo="000"
    ok=0
    for tentativa in 1 2 3 4 5; do
        codigo="$(curl -s -o /dev/null -w '%{http_code}' "$url" || echo "000")"
        if [[ "$codigo" == 2* || "$codigo" == 3* ]]; then
            ok=1
            break
        fi
        sleep 3
    done
    if [ "$ok" -eq 1 ]; then
        echo "OK (HTTP $codigo)"
    else
        echo "FALHOU (último HTTP: $codigo)"
        SMOKE_TEST_FAILED=1
    fi
done

if [ "$SMOKE_TEST_FAILED" -ne 0 ]; then
    cat <<EOF

ERRO: smoke test falhou para pelo menos uma URL. NÃO remova "$SRC_DIR".

Os serviços já foram religados apontando para "$DST_DIR" (fases 3-4 já
rodaram). Investigue antes com:

         sudo systemctl status <serviço>
         sudo journalctl -u <serviço> -n 100

Se decidir reverter, os comandos completos são (apenas indicativo - revise
cada um antes de rodar; nada disso é executado automaticamente):

  1) Parar os serviços de novo:
EOF
    for svc in "${SERVICES_TO_STOP[@]}"; do
        echo "         sudo systemctl stop $svc"
    done
    cat <<EOF

  2) Restaurar os arquivos de referência a partir do backup ($BACKUP_DIR):
EOF
    for f in "${REFERENCE_FILES[@]}"; do
        if [ -f "$BACKUP_DIR$f" ]; then
            echo "         sudo cp \"$BACKUP_DIR$f\" \"$f\""
        fi
    done
    cat <<EOF

  3) sudo systemctl daemon-reload

  4) Reaplicar a config do CloudWatch agent, agora de volta apontando para
     $SRC_DIR:

         sudo /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \\
             -a fetch-config -m ec2 -s \\
             -c file:/opt/aws/amazon-cloudwatch-agent/bin/config.json

  5) Subir os serviços de volta (mesma ordem da fase 4 - dependência
     primeiro):
EOF
    for (( idx=${#SERVICES_TO_STOP[@]}-1 ; idx>=0 ; idx-- )); do
        svc="${SERVICES_TO_STOP[$idx]}"
        echo "         sudo systemctl start $svc"
    done
    cat <<EOF

  6) Confirme com "systemctl status <serviço>" e um teste manual (curl ou
     navegador nas URLs de SMOKE_TEST_URLS) que voltou a funcionar a partir
     de "$SRC_DIR".

Nada em "$SRC_DIR" ou "$DST_DIR" foi apagado - a reversão acima só troca as
referências de volta. Investigue a causa da falha em "$DST_DIR" com calma
antes de tentar migrar de novo.
EOF
    exit 1
fi

# ---- Fase 6: remoção da origem - AÇÃO MANUAL NECESSÁRIA ----
cat <<EOF

==> Smoke test OK em $DST_DIR (todos os serviços religados e respondendo).

  SÓ DEPOIS de você mesmo confirmar que está tudo funcionando (status dos
  serviços, logs recentes, uso real da aplicação, e no console do CloudWatch
  que os logs novos estão chegando a partir de $DST_DIR), remova a origem
  manualmente (não é feito por este script):

         sudo rm -rf "$SRC_DIR"

EOF
