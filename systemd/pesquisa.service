[Unit]
Description=Sistema Flask Yoko-Pesquisa
After=network.target

[Service]
User=pesquisa
Group=pesquisa
UMask=0002
WorkingDirectory=/opt/moduloPesquisaPRPI/app
Environment=GIT_PYTHON_REFRESH=quiet
#Environment="PATH=/opt/moduloPesquisaPRPI/app/env/bin"
Environment="PATH=/opt/moduloPesquisaPRPI/app/env/bin:/usr/bin:/usr/local/bin"
Environment="PRODUCAO=1"
Environment="AWS_DEFAULT_REGION=us-east-2"
#Environment="AWS_CONFIG_FILE=/home/admin/.aws/config"
Environment="AWS_USE_DUALSTACK_ENDPOINT=true"
#ExecStart=sh -c 'redis-cli FLUSHALL  && /opt/moduloPesquisaPRPI/app/env/bin/python pesquisa.py'
ExecStart=/opt/moduloPesquisaPRPI/app/env/bin/python /opt/moduloPesquisaPRPI/app/pesquisa.py
Restart=on-failure
RestartSec=5

# Contém o consumo de memória a este cgroup em vez de deixar o app crescer
# até o OOM killer global escolher uma vítima arbitrária na VPS (foi o que
# aconteceu em 2026-08-05: pico de 327.5M sem limite nenhum configurado).
# MemoryHigh joga backpressure (reclaim agressivo) antes do teto; MemoryMax
# é o teto rígido — se estourar, só este serviço morre e o Restart=on-failure
# já traz de volta em 5s.
MemoryHigh=350M
MemoryMax=450M

# Torna este serviço o último a ser escolhido pelo OOM killer global (ex: em
# vez do sage_bot ou de outro processo), já que é o serviço de produção.
OOMScoreAdjust=-500

# Isolamento e Segurança (compatível com Boto3/SSM, MariaDB e GPG do usuário
# pesquisa em /home/pesquisa/.gnupg)
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/moduloPesquisaPRPI/app /home/pesquisa /tmp /var/tmp
PrivateTmp=false
NoNewPrivileges=true
ProtectKernelTunables=false
ProtectControlGroups=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
