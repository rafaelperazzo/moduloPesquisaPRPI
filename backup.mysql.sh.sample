#!/bin/bash
set -eo pipefail

# --- Configura    es e Vari  veis ---
BASE_DIR="/home/admin/moduloPesquisaPRPI"
SHARE_DIR="${BASE_DIR}/share"
DB_NAME="pesquisa"             # Caso queira incluir ambos, use a flag --databases no dump
DB_USER="backup"
DB_HOST="localhost"
AWS_REGION="us-east-2"
S3_BUCKET="s3://rajardekalambur/pesquisa/backup/"

# Par  metros no AWS SSM Parameter Store
SSM_PARAM_DB_PASS="/pesquisa/MYSQL_BACKUP_PASSWORD"
SSM_PARAM_GPG_KEY="/pesquisa/GPG_KEY"

TIMESTAMP=$(/usr/bin/date '+%Y-%m-%dT%H.%M')
OUTPUT_FILE="${SHARE_DIR}/${TIMESTAMP}-pesquisa.sql.gz.gpg"

mkdir -p "$SHARE_DIR"

# --- Obter Credenciais do AWS SSM ---
echo "Recuperando credenciais do AWS SSM (Regi  o: ${AWS_REGION})..."
export MYSQL_PWD=$(aws ssm get-parameter \
  --name "$SSM_PARAM_DB_PASS" \
  --region "$AWS_REGION" \
  --with-decryption \
  --query "Parameter.Value" \
  --output text)

GPG_KEY=$(aws ssm get-parameter \
  --name "$SSM_PARAM_GPG_KEY" \
  --region "$AWS_REGION" \
  --with-decryption \
  --query "Parameter.Value" \
  --output text)

# --- Dump, Limpeza de DEFINER, Compress  o e Criptografia ---
echo "Executando Dump com o usu  rio '$DB_USER'..."

mariadb-dump -h "$DB_HOST" -u "$DB_USER" \
  --single-transaction \
  --no-tablespaces \
  --add-drop-table \
  --quick \
  "$DB_NAME" \
  | sed -E 's/\sDEFINER=`[^`]*`@`[^`]*`//g' \
  | gzip -c \
  | gpg --batch --yes --symmetric --armor \
        --cipher-algo AES256 \
        --passphrase "$GPG_KEY" \
        -o "$OUTPUT_FILE"

# Limpa credenciais da mem  ria
unset MYSQL_PWD GPG_KEY
# --- Rota    o de Backups Locais (Mant  m os 21 mais recentes) ---
echo "Limpando backups locais antigos..."
cd "$SHARE_DIR"
ls -1t *-pesquisa.sql.gz.gpg 2>/dev/null | tail -n +22 | xargs -r rm -f

# --- Sincroniza    o com AWS S3 ---
echo "Sincronizando com S3..."
aws s3 sync "$SHARE_DIR/" "$S3_BUCKET" --region "$AWS_REGION" --delete --exclude "*" --include "*.gpg"

echo "Backup conclu  do com sucesso: ${OUTPUT_FILE}"

