#!/bin/bash
set -e

# Diretório base do projeto
folder="/home/perazzo/UFRPE/docker/projetos/pesquisa"
cd "$folder"

# Valida a existência do arquivo .env
if [ ! -f .env ]; then
  echo "Erro: Arquivo .env não encontrado em $folder"
  exit 1
fi

# Carrega as variáveis a partir do .env
MYSQL_ROOT_PASSWORD=$(grep -E "^MYSQL_ROOT_PASSWORD=" .env | cut -d '=' -f 2- | tr -d '"' | tr -d "'")
MYSQL_DATABASE=$(grep -E "^MYSQL_DATABASE=" .env | cut -d '=' -f 2- | tr -d '"' | tr -d "'")
GPG_KEY=$(grep -E "^GPG_KEY=" .env | cut -d '=' -f 2- | tr -d '"' | tr -d "'")

# Garante que o diretório temporário exista
mkdir -p share

echo "==> BAIXANDO O ÚLTIMO BACKUP DO BANCO DE DADOS (S3)"
S3_BUCKET="s3://rajardekalambur/pesquisa/backup/"
arquivo=$(aws s3 ls "$S3_BUCKET" | sort -k1,2 | tail -1 | awk '{print $4}')

if [ -z "$arquivo" ]; then
  echo "Erro: Nenhum arquivo encontrado no bucket S3."
  exit 1
fi

echo "Arquivo encontrado: $arquivo"
aws s3 cp "${S3_BUCKET}${arquivo}" "share/${arquivo}"

echo "==> DESCRIPTOGRAFANDO E DESCOMPACTANDO"
gpg -o share/ultimo.sql.gz --decrypt --batch --yes --passphrase "$GPG_KEY" "share/$arquivo"
gunzip -f share/ultimo.sql.gz

echo "==> ATUALIZANDO O BANCO PRINCIPAL ($MYSQL_DATABASE)"
docker compose exec -T db_pesquisa bash -c "mariadb -u root -p'$MYSQL_ROOT_PASSWORD' '$MYSQL_DATABASE' < /share/ultimo.sql"

echo "==> CLONANDO/CRIANDO O BANCO DE TESTE (pesquisa_test)"
docker compose exec -T db_pesquisa bash -c "
  mariadb -u root -p'$MYSQL_ROOT_PASSWORD' -e 'DROP DATABASE IF EXISTS \`pesquisa_test\`; CREATE DATABASE \`pesquisa_test\`;'
  mariadb -u root -p'$MYSQL_ROOT_PASSWORD' pesquisa_test < /share/ultimo.sql
  mariadb -u root -p'$MYSQL_ROOT_PASSWORD' -e \"GRANT ALL PRIVILEGES ON \\\`pesquisa_test\\\`.* TO 'pesquisa'@'%'; FLUSH PRIVILEGES;\"
"

echo "==> LIMPANDO ARQUIVOS TEMPORÁRIOS"
rm -f share/ultimo.sql
rm -f "share/$arquivo"
rm -f share/*.gpg

echo "==> PROCESSO E CLONAGEM CONCLUÍDOS COM SUCESSO!"